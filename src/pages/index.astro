---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort((a, b) =>
    a.localeCompare(b),
);
const locations = [...new Set(jobs.map((job) => job.location))].sort((a, b) =>
    a.localeCompare(b),
);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <section aria-labelledby="open-roles-heading">
      <h2 id="open-roles-heading" class="text-2xl font-medium mb-6 text-slate-100">
        Open roles
      </h2>

      {jobs.length === 0 ? (
        <EmptyState text="There are no open roles right now. Check back soon." />
      ) : (
        <>
          <div
            role="group"
            class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto]"
            aria-label="Filter open roles"
          >
            <div>
              <label for="department-filter" class="block text-sm font-medium text-slate-200 mb-2">
                Department
              </label>
              <select
                id="department-filter"
                data-testid="department-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-blue-400 focus-visible:outline-offset-2"
              >
                <option value="">All departments</option>
                {departments.map((department) => <option value={department}>{department}</option>)}
              </select>
            </div>
            <div>
              <label for="location-filter" class="block text-sm font-medium text-slate-200 mb-2">
                Location
              </label>
              <select
                id="location-filter"
                data-testid="location-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-blue-400 focus-visible:outline-offset-2"
              >
                <option value="">All locations</option>
                {locations.map((location) => <option value={location}>{location}</option>)}
              </select>
            </div>
            <button
              type="button"
              data-testid="filters-reset"
              class="self-end rounded-lg border border-slate-600 px-4 py-2 text-slate-200 hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-blue-400 focus-visible:outline-offset-2"
            >
              Reset filters
            </button>
          </div>

          <p class="mb-4 text-sm text-slate-400" aria-live="polite" data-testid="roles-count">
            {jobs.length} {jobs.length === 1 ? 'role' : 'roles'}
          </p>
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            data-testid="roles-grid"
          >
            {jobs.map((job) => <RoleCard job={job} />)}
          </div>
          <div data-testid="filtered-empty-state" hidden>
            <EmptyState text="No roles match these filters. Try different options or reset the filters." />
          </div>
          <script
            id="jobs-data"
            type="application/json"
            is:inline
            set:html={JSON.stringify(jobs).replace(/</g, '\\u003c')}
          ></script>
        </>
      )}
    </section>
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';
  import type { Job } from '../types/job';

  const jobsData = document.querySelector<HTMLScriptElement>('#jobs-data');
  const departmentFilter = document.querySelector<HTMLSelectElement>('#department-filter');
  const locationFilter = document.querySelector<HTMLSelectElement>('#location-filter');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="filters-reset"]');
  const roleCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="role-card"]'));
  const rolesGrid = document.querySelector<HTMLElement>('[data-testid="roles-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const rolesCount = document.querySelector<HTMLElement>('[data-testid="roles-count"]');

  if (
    jobsData &&
    departmentFilter &&
    locationFilter &&
    resetButton &&
    rolesGrid &&
    emptyState &&
    rolesCount
  ) {
    const jobs: Job[] = JSON.parse(jobsData.textContent ?? '[]');

    const updateRoles = () => {
      const matchingJobs = filterJobs(jobs, departmentFilter.value, locationFilter.value);
      const matchingSlugs = new Set(matchingJobs.map((job) => job.slug));

      for (const card of roleCards) {
        card.hidden = !matchingSlugs.has(card.dataset.jobId ?? '');
      }

      rolesGrid.hidden = matchingJobs.length === 0;
      emptyState.hidden = matchingJobs.length !== 0;
      rolesCount.textContent = `${matchingJobs.length} ${matchingJobs.length === 1 ? 'role' : 'roles'}`;
    };

    departmentFilter.addEventListener('change', updateRoles);
    locationFilter.addEventListener('change', updateRoles);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      updateRoles();
    });
  }
</script>
